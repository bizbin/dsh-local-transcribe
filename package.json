{
  "name": "dsh-local-transcribe",
  "version": "1.0.0",
  "description": "DeepSeek Harness (DSH) plugin for fully-local speech-to-text with whisper.cpp: a visual panel to pick, merge, preview, and edit audio files, plus a transcribe_audio agent tool.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bizbin/dsh-local-transcribe"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "whisper",
    "whisper.cpp",
    "speech-to-text",
    "transcription",
    "offline"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
